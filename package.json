{
  "name": "qd766-commune-analytics",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Commune-first analytics workspace for QĐ766 fixtures",
  "scripts": {
    "data": "python tools/build_web_data.py",
    "typecheck": "tsc --noEmit",
    "build": "npm run data && node tools/prepare_excel_vendor.mjs && tsc",
    "build:netlify": "node tools/prepare_excel_vendor.mjs && tsc && node tools/package_netlify.mjs",
    "test:netlify": "npm run build:netlify && node web/tests/netlify-package.test.mjs",
    "test:analytics": "npm run build && node web/tests/analytics-integrity.test.mjs",
    "test:summary-ui": "npm run build && node web/tests/summary-only-ui.test.mjs",
    "test:bento": "npm run build && node web/tests/bento.test.mjs",
    "test:formulas": "npm run build && node web/tests/formula-reference.test.mjs && node web/tests/summary-only-ui.test.mjs",
    "test:excel": "npm run build && node web/tests/excel-export.test.mjs",
    "test:leadership": "npm run build && node web/tests/leadership-report.test.mjs",
    "test:collection-ui": "npm run build && node web/tests/collection-tracker.test.mjs && node web/tests/collection-flow.test.mjs && node web/tests/collection-flow.test.mjs --restore",
    "test:progress": "npm run build && node web/tests/progress-scoring.test.mjs",
    "test:csv": "npm run build && node web/tests/csv-export.test.mjs",
    "serve": "python tools/serve_app.py",
    "serve:static": "python tools/serve_web.py"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "tom-select": "2.6.2"
  }
}
