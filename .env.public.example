# Copy to .env.public locally. Never commit the filled-in file or share secrets.
# Only these three entries are allowed. Operator and billing flags cannot override it.
QD766_GOOGLE_CLIENT_ID=<web-client-id.apps.googleusercontent.com>
QD766_GOOGLE_CLIENT_SECRET=<client-secret>
QD766_GOOGLE_REDIRECT_URI=https://api.bochiso766.com/api/v1/auth/google/callback
