# Local development only. Do not commit a real password.
QD766_DATABASE_USER=qd766_app
QD766_DATABASE_PASSWORD=change-me
QD766_DATABASE_HOST=127.0.0.1
QD766_DATABASE_PORT=5432
QD766_DATABASE_NAME=qd766
QD766_CORS_ORIGINS=http://127.0.0.1:8766
QD766_SQL_ECHO=false
# Leave false on the office operator server. Enable only on a separate preview instance.
# This is NOT account login or production authorization.
QD766_PUBLIC_READ_ONLY=false
# Configure these only in the intended instance; keep secrets out of Git/chat.
QD766_REQUIRE_LOGIN=false
QD766_GOOGLE_CLIENT_ID=
QD766_GOOGLE_CLIENT_SECRET=
QD766_GOOGLE_REDIRECT_URI=
QD766_DASHBOARD_CACHE_TTL_SECONDS=60
# Optional catalog source overrides. Defaults point to ChippedTopaz/am-sieu-toc-data.
# QD766_PROVINCE_CATALOG_INDEX_URL=https://raw.githubusercontent.com/ChippedTopaz/am-sieu-toc-data/data/index.json
# QD766_PROVINCE_CATALOG_VERSION_URL=https://raw.githubusercontent.com/ChippedTopaz/am-sieu-toc-data/data/version.json
# QD766_PROVINCE_CATALOG_RULES_URL=https://raw.githubusercontent.com/ChippedTopaz/am-sieu-toc-data/niemyet/isVertical.json
# QD766_PROVINCE_CATALOG_CACHE_TTL_SECONDS=3600
# QD766_PROVINCE_CATALOG_TIMEOUT_SECONDS=30
# Optional. Deployed default: D:\QD766\data\collections
QD766_COLLECTION_ROOT=D:\QD766\data\collections
